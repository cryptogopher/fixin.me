<% target_id = dom_target(:new, @quantity.parent || :quantity) %>
<% ids = {row: target_id,
          hidden_row: nil,
          link: dom_target(target_id, :link),
          form_tag: dom_target(target_id, :form)} %>

<%= turbo_stream.disable ids[:link] -%>

<%= turbo_stream.append_all 'body' do %>
  <%- tabular_form_with model: @quantity, html: {id: ids[:form_tag]} do |form| %>
    <%= form.hidden_field :parent_id if @quantity.parent_id? %>
  <% end %>
<% end %>

<%= turbo_stream.after @quantity.parent || :quantity_, partial: 'form', locals: ids %>

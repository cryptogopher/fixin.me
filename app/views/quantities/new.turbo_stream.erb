<% target_id = dom_target(:new, @quantity.parent || :quantity) %>
<% attrs = {record: @quantity,
            id: target_id,
            data: {form: dom_target(target_id, :form),
                   hidden_row: nil,
                   link: dom_target(target_id, :link)}} %>

<%= turbo_stream.disable attrs[:data][:link] -%>

<%= turbo_stream.append_all 'body' do %>
  <%- tabular_form_with model: @quantity, html: {id: attrs[:data][:form]} do |form| %>
    <%= form.hidden_field :parent_id if @quantity.parent_id? %>
  <% end %>
<% end %>

<%= turbo_stream.after @quantity.parent || :quantity_, partial: 'form', locals: attrs %>

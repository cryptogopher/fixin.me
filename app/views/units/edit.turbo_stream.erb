<% attrs = {record: @unit,
            id: dom_target(:edit, @unit),
            data: {form: dom_target(:edit, @unit, :form),
                   hidden_row: dom_target(@unit),
                   link: nil}} %>

<%= turbo_stream.append_all 'body' do %>
  <%- tabular_form_with model: @unit, html: {id: attrs[:data][:form]} do %>
  <% end %>
<% end %>

<%= turbo_stream.hide attrs[:data][:hidden_row] %>
<%= turbo_stream.after @unit, partial: 'form', locals: attrs -%>

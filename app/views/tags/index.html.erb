<div class="rightside-area buttongrid">
  <% if current_user.at_least(:active) %>
    <%= image_link_to t('.new_tag'), 'plus-outline', new_tag_path, id: :new_tag_link,
      onclick: 'this.blur();', data: {turbo_stream: true} %>
  <% end %>
  <%#= image_link_to t('.import_tags'), 'download-outline', default_tags_path,
    class: 'tools-area' %>
</div>

<table class="main-area items-table">
  <caption class="hint"><%= t '.no_items' %></caption>

  <tbody>
    <tr>
      <th class="hmintext"><%= Tag.human_attribute_name(:label) %>
      <th class="hexpand"><%= Tag.human_attribute_name(:description) %>
    <% if current_user.at_least(:active) %>
      <th colspan="3"><%= t :actions %>

    <tr id="tag_" hidden
      ondragover="dragOver(event)" ondrop="drop(event)"
      ondragenter="dragEnter(event)" ondragleave="dragLeave(event)"
      data-drop-id="tag_" data-drop-id-param="<%= field_name(:tag, :supertag_id) %>">
      <th colspan="5"><%= t '.top_level_drop' %>
    <% end %>

    <%= render @tags %>

  <% if current_user.at_least(:active) %>
    <tr id="endmark" hidden>

  <tfoot>
    <%= render partial: 'form', locals: {hidden: true} %>
  <% end %>
</table>
